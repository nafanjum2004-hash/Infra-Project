pipeline {
    agent any

    environment {
        TF_VAR_FILE = "terraform/environments/dev/terraform.tfvars"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Build Application') {
            steps {
                sh 'mvn clean package'
            }
        }
    }

        stage('Terraform Validate') {
            steps {
                dir('terraform') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('terraform') {
                    sh 'terraform plan -var-file=environments/dev/terraform.tfvars'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('terraform') {
                    sh 'terraform apply -auto-approve -var-file=environments/dev/terraform.tfvars'
                }
            }
        }

        stage('Generate Inventory') {
            steps {
                echo 'Generate inventory from Terraform output'
            }
        }

        stage('Run Ansible') {
            steps {
                echo 'Run Ansible deployment'
            }
        }

        stage('Health Check') {
            steps {
                echo 'Verify application health endpoint'
            }
        }
    }
}